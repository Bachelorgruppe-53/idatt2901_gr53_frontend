{
  "expo": {
    "name": "SJUK",
    "slug": "Bacheloroppgave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bacheloroppgave",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brahimage.appBacheloroppgave",
      "icon": "./assets/images/icon/sjuk.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We need your location in order to display it on the map, it is not saved or used for any other purpose.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location in order to display it on the map, it is not saved or used for any other purpose."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brahimage.appBacheloroppgave",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA_J7CnbJU8evAK1RP0iSHh5RqaTXSappE"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ee55494-9190-4f6d-bc8d-0e4ca7fb57cf"
      }
    },
    "owner": "bacheloroppgavegr53",
    "updates": {
      "url": "https://u.expo.dev/8ee55494-9190-4f6d-bc8d-0e4ca7fb57cf"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
